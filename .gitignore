import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from psp_emulator.core import MemoryMap, MIPS32Core, PSPMemoryMap
from psp_emulator.emulator import PSPEmulator


def test_memory_round_trip():
    memory = MemoryMap()
    memory.write_u32(0x1000, 0x12345678)
    assert memory.read_u32(0x1000) == 0x12345678


def test_psp_memory_regions():
    memory = PSPMemoryMap()
    assert memory.region_for(0x08000000) == "user_ram"
    assert memory.region_for(0x00010000) == "scratchpad"
    assert memory.region_for(0x04000000) == "vram"


def test_cpu_addi_and_add():
    memory = MemoryMap()
    cpu = MIPS32Core(memory)
    cpu.pc = 0x1000
    memory.write_u32(0x1000, 0x24090005)  # addiu t1, zero, 5
    memory.write_u32(0x1004, 0x240A0003)  # addiu t2, zero, 3
    memory.write_u32(0x1008, 0x012A4020)  # add a0, t1, t2
    cpu.step(); cpu.step(); cpu.step()
    assert cpu.read_reg("t1") == 5
    assert cpu.read_reg("t2") == 3
    assert cpu.read_reg("a0") == 8


def test_cpu_branch_and_jump():
    memory = MemoryMap()
    cpu = MIPS32Core(memory)
    cpu.pc = 0x2000
    memory.write_u32(0x2000, 0x24090001)  # t1 = 1
    memory.write_u32(0x2004, 0x240A0002)  # t2 = 2
    memory.write_u32(0x2008, 0x152A0001)  # bne t1, t2, +1 instruction
    memory.write_u32(0x200C, 0x00000000)  # nop
    memory.write_u32(0x2010, 0x240B0007)  # t3 = 7
    cpu.step(); cpu.step(); cpu.step(); cpu.step()
    assert cpu.read_reg("t3") == 7


def test_psp_demo_boot():
    emulator = PSPEmulator()
    emulator.load_demo_program()
    emulator.run(4)
    assert emulator.cpu.read_reg("t1") == 5
    assert emulator.cpu.read_reg("t2") == 3
    assert emulator.cpu.read_reg("a0") == 8
